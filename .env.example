# Copy this to .env and fill in your keys
OPENAI_API_KEY=sk-...
# OR use Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Target companies for job search (Greenhouse board slugs)
# Find slug from: https://boards.greenhouse.io/{slug}
GREENHOUSE_COMPANY_SLUGS=airbnb,stripe,notion

# Your info for auto-filling applications
APPLICANT_NAME=Your Full Name
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE=+1234567890
