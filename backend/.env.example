# Duplicate of the root .env.example, kept for reference.
# The app loads the ROOT .env -- edit that one.

# ── Required ───────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Greenhouse boards to search (comma separated slugs)
GREENHOUSE_COMPANY_SLUGS=airbnb,stripe,notion

# ── Applicant details ──────────────────────────────────────
# Used when filling application forms. These override whatever
# was parsed out of the resume PDF. Give APPLICANT_NAME your FULL
# name -- a single word leaves the required surname field as ".".
APPLICANT_NAME=Your Full Name
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=+15551234567

# ── API server ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
